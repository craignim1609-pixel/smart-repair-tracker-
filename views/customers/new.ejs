<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Customer</title>

  <style>
    body { 
      font-family: Arial, sans-serif; 
      background: #f5f5f5; 
      padding: 20px; 
    }
    .container { 
      max-width: 600px; 
      margin: auto; 
      background: white; 
      padding: 25px; 
      border-radius: 10px; 
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    label { 
      font-weight: bold; 
      display: block; 
      margin-top: 15px; 
    }
    input { 
      width: 100%; 
      padding: 10px; 
      border-radius: 6px; 
      border: 1px solid #ccc; 
      margin-top: 5px;
    }
    button { 
      margin-top: 20px; 
      width: 100%; 
      padding: 12px; 
      background: #0078ff; 
      color: white; 
      border: none; 
      border-radius: 6px; 
      cursor: pointer;
    }
    #successBox {
      display:none; 
      margin-top:15px; 
      background:#d4ffd4; 
      padding:10px; 
      border-radius:6px;
      font-weight: bold;
    }
  </style>
</head>

<body>
<%- include('../partials/nav') %>

<div class="container">
  <h2>Add Customer</h2>

  <form id="customerForm">
    <label>Name</label>
    <input name="name" required>

    <label>Phone</label>
    <input name="phone">

    <label>Email</label>
    <input name="email">

    <button type="submit">Save Customer</button>
  </form>

  <div id="successBox"></div>
</div>

<script>
document.getElementById("customerForm").onsubmit = async (e) => {
  e.preventDefault();

  const formData = new FormData(e.target);
  const body = Object.fromEntries(formData.entries());

  // Correct route (your router handles POST /customers)
  const res = await fetch("/customers", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body)
  });

  // The server redirects, so we manually show success
  const box = document.getElementById("successBox");
  box.style.display = "block";
  box.textContent = `Customer ${body.name} added successfully!`;

  e.target.reset();
};
</script>

</body>
</html>
