<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Jobs Dashboard</title>

  <style>
    body { font-family: Arial; background:#f5f5f5; padding:20px; }
    .container { max-width: 1100px; margin:auto; }
    h1 { text-align:center; }

    .cards {
      display:flex;
      gap:20px;
      margin-top:20px;
      flex-wrap:wrap;
    }

    .card {
      flex:1;
      min-width:250px;
      background:white;
      padding:20px;
      border-radius:10px;
      box-shadow:0 0 10px rgba(0,0,0,0.1);
      text-align:center;
    }

    .big-number {
      font-size:40px;
      font-weight:bold;
      margin-top:10px;
    }

    .status-bar {
      margin-top:30px;
      background:white;
      padding:20px;
      border-radius:10px;
      box-shadow:0 0 10px rgba(0,0,0,0.1);
    }

    .status-row {
      display:flex;
      justify-content:space-between;
      padding:10px 0;
      border-bottom:1px solid #eee;
    }

    .status-row:last-child {
      border-bottom:none;
    }

    a {
      color:#0078ff;
      font-weight:bold;
      text-decoration:none;
    }
    a:hover { text-decoration:underline; }
  </style>
</head>

<body>
<%- include('../partials/nav') %>

<div class="container">
  <h1>Workshop Dashboard</h1>

  <!-- SUMMARY CARDS -->
  <div class="cards">
    <div class="card">
      <div>Total Jobs</div>
      <div id="totalJobs" class="big-number">0</div>
    </div>

    <div class="card">
      <div>In Progress</div>
      <div id="inProgress" class="big-number">0</div>
    </div>

    <div class="card">
      <div>Awaiting Parts</div>
      <div id="awaitingParts" class="big-number">0</div>
    </div>

    <div class="card">
      <div>Completed</div>
      <div id="completed" class="big-number">0</div>
    </div>
  </div>

  <!-- STATUS BREAKDOWN -->
  <div class="status-bar">
    <h2>Status Breakdown</h2>
    <div id="statusList"></div>
  </div>

</div>

<script>
async function loadDashboard() {
  const res = await fetch("/jobs/api/list");
  const jobs = await res.json();

  // Summary counts
  document.getElementById("totalJobs").innerText = jobs.length;
  document.getElementById("inProgress").innerText = jobs.filter(j => j.status === "in_progress").length;
  document.getElementById("awaitingParts").innerText = jobs.filter(j => j.status === "awaiting_parts").length;
  document.getElementById("completed").innerText = jobs.filter(j => j.status === "completed").length;

  // Status breakdown
  const statuses = {};
  jobs.forEach(j => {
    statuses[j.status] = (statuses[j.status] || 0) + 1;
  });

  const statusList = document.getElementById("statusList");
  statusList.innerHTML = Object.entries(statuses)
    .map(([status, count]) => `
      <div class="status-row">
        <div>${status.replace("_", " ")}</div>
        <div><strong>${count}</strong></div>
      </div>
    `)
    .join("");
}

loadDashboard();
</script>

</body>
</html>
