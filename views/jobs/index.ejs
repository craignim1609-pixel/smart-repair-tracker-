<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>All Jobs</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      padding: 20px;
    }
    .container {
      max-width: 1000px;
      margin: auto;
      background: white;
      padding: 25px;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    h2 {
      text-align: center;
      margin-top: 0;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }
    th, td {
      padding: 12px;
      border-bottom: 1px solid #ddd;
      text-align: left;
    }
    th {
      background: #0078ff;
      color: white;
    }
    tr:hover {
      background: #f0f8ff;
    }
    a {
      color: #0078ff;
      font-weight: bold;
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }
    .filters {
      display: flex;
      gap: 15px;
      margin-top: 20px;
    }
    .filters input, .filters select {
      padding: 10px;
      width: 100%;
      border-radius: 6px;
      border: 1px solid #ccc;
    }
  </style>
</head>

<body>
<%- include('../partials/nav') %>

<div class="container">
  <h2>All Repair Jobs</h2>

  <!-- FILTER BAR -->
  <div class="filters">
    <input type="text" id="searchInput" placeholder="Search job number, customer, item...">

    <select id="statusFilter">
      <option value="">All Statuses</option>
      <option value="booked_in">Booked In</option>
      <option value="in_progress">In Progress</option>
      <option value="awaiting_parts">Awaiting Parts</option>
      <option value="completed">Completed</option>
      <option value="unrepairable">Unrepairable</option>
    </select>

    <select id="customerFilter">
      <option value="">All Customers</option>
      <% [...new Set(jobs.map(j => j.customer_name))].forEach(name => { %>
        <% if (name) { %>
          <option value="<%= name %>"><%= name %></option>
        <% } %>
      <% }) %>
    </select>

    <select id="itemFilter">
      <option value="">All Items</option>
      <% [...new Set(jobs.map(j => j.item_type))].forEach(type => { %>
        <option value="<%= type %>"><%= type %></option>
      <% }) %>
    </select>
  </div>

  <!-- JOB TABLE -->
  <table id="jobsTable">
    <thead>
      <tr>
        <th>Job Number</th>
        <th>Customer</th>
        <th>Item</th>
        <th>Status</th>
      </tr>
    </thead>

    <tbody id="jobsBody">
      <% if (jobs && jobs.length > 0) { %>
        <% jobs.forEach(job => { %>
          <tr>
            <td>
              <a href="/jobs/<%= job.id %>">
                <%= job.job_number %>
              </a>
            </td>
            <td><%= job.customer_name || "Non‑Customer Job" %></td>
            <td><%= job.item_type %></td>
            <td><%= job.status %></td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="4" style="text-align:center; padding:20px;">
            No jobs found.
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<script>
const searchInput = document.getElementById("searchInput");
const statusFilter = document.getElementById("statusFilter");
const customerFilter = document.getElementById("customerFilter");
const itemFilter = document.getElementById("itemFilter");
const rows = Array.from(document.querySelectorAll("#jobsBody tr"));

function applyFilters() {
  const search = searchInput.value.toLowerCase();
  const status = statusFilter.value.toLowerCase();
  const customer = customerFilter.value.toLowerCase();
  const item = itemFilter.value.toLowerCase();

  rows.forEach(row => {
    const cells = row.querySelectorAll("td");
    const jobNumber = cells[0].innerText.toLowerCase();
    const customerName = cells[1].innerText.toLowerCase();
    const itemType = cells[2].innerText.toLowerCase();
    const jobStatus = cells[3].innerText.toLowerCase();

    const matchesSearch =
      jobNumber.includes(search) ||
      customerName.includes(search) ||
      itemType.includes(search);

    const matchesStatus = !status || jobStatus === status;
    const matchesCustomer = !customer || customerName === customer;
    const matchesItem = !item || itemType === item;

    row.style.display =
      matchesSearch && matchesStatus && matchesCustomer && matchesItem
        ? ""
        : "none";
  });
}

searchInput.addEventListener("input", applyFilters);
statusFilter.addEventListener("change", applyFilters);
customerFilter.addEventListener("change", applyFilters);
itemFilter.addEventListener("change", applyFilters);
</script>

</body>
</html>
