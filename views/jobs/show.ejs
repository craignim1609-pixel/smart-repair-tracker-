<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Job Details</title>

  <style>
    body { font-family: Arial; background:#f5f5f5; padding:20px; }
    .section { background:white; padding:20px; margin-bottom:20px; border-radius:8px; }
    h2 { margin-top:0; }
    label { font-weight:bold; display:block; margin-top:10px; }
    input, select, textarea { width:100%; padding:8px; margin-top:5px; }
    table { width:100%; border-collapse:collapse; margin-top:10px; }
    th, td { border:1px solid #ccc; padding:8px; }
    button { margin-top:10px; padding:10px; background:#0078ff; color:white; border:none; border-radius:6px; cursor:pointer; }
  </style>
</head>

<body>

<div id="jobContainer">Loading job…</div>

<script>
async function loadJob() {
  const jobId = "<%= jobId %>";
  const res = await fetch(`/jobs/api/${jobId}`);
  const data = await res.json();

  const job = data.job;
  const parts = data.parts;
  const techs = data.technicians;

  document.getElementById("jobContainer").innerHTML = `
    <div class="section">
      <h2>Job ${job.job_number}</h2>
      <label>Status</label>
      <select id="status">
        <option value="booked_in" ${job.status === "booked_in" ? "selected" : ""}>Booked In</option>
        <option value="in_progress" ${job.status === "in_progress" ? "selected" : ""}>In Progress</option>
        <option value="awaiting_parts" ${job.status === "awaiting_parts" ? "selected" : ""}>Awaiting Parts</option>
        <option value="completed" ${job.status === "completed" ? "selected" : ""}>Completed</option>
        <option value="unrepairable" ${job.status === "unrepairable" ? "selected" : ""}>Unrepairable</option>
      </select>
      <button onclick="updateField('status', document.getElementById('status').value)">Save Status</button>
    </div>

    <div class="section">
      <h2>Customer</h2>
      <p><strong>Name:</strong> ${job.customer_name}</p>
      <p><strong>Phone:</strong> ${job.customer_phone || "N/A"}</p>
      <p><strong>Email:</strong> ${job.customer_email || "N/A"}</p>
    </div>

    <div class="section">
      <h2>Item Details</h2>
      <p><strong>Type:</strong> ${job.item_type}</p>
      <p><strong>Brand:</strong> ${job.brand || "N/A"}</p>
      <p><strong>Model:</strong> ${job.model || "N/A"}</p>
      <p><strong>Serial:</strong> ${job.serial_number || "N/A"}</p>
    </div>

    <div class="section">
      <h2>Fault Reported</h2>
      <textarea id="fault">${job.fault_reported}</textarea>
      <button onclick="updateField('fault_reported', document.getElementById('fault').value)">Save Fault</button>
    </div>

    <div class="section">
      <h2>Parts</h2>
      <table>
        <tr><th>Part</th><th>Cost</th><th>Action</th></tr>
        ${parts.map(p => `
          <tr>
            <td>${p.part_name}</td>
            <td>£${p.part_cost}</td>
            <td><button onclick="removePart(${p.id})">Remove</button></td>
          </tr>
        `).join("")}
      </table>

      <h3>Add Part</h3>
      <input id="partName" placeholder="Part name">
      <input id="partCost" placeholder="Cost">
      <button onclick="addPart()">Add Part</button>
    </div>

    <div class="section">
      <h2>Technician Time</h2>
      <table>
        <tr><th>Technician</th><th>Minutes</th><th>Action</th></tr>
        ${techs.map(t => `
          <tr>
            <td>${t.name}</td>
            <td>${t.minutes_worked}</td>
            <td><button onclick="removeTech(${t.id})">Remove</button></td>
          </tr>
        `).join("")}
      </table>

      <h3>Add Technician Time</h3>
      <select id="techSelect">
        ${techs.map(t => `<option value="${t.id}">${t.name}</option>`).join("")}
      </select>
      <input id="minutes" placeholder="Minutes worked">
      <button onclick="addTech()">Add Time</button>
    </div>
  `;
}

async function updateField(field, value) {
  const jobId = "<%= jobId %>";
  await fetch(`/jobs/api/${jobId}`, {
    method: "PATCH",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ [field]: value })
  });
  loadJob();
}

async function addPart() {
  const jobId = "<%= jobId %>";
  await fetch(`/jobs/api/${jobId}/parts`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      part_name: document.getElementById("partName").value,
      part_cost: document.getElementById("partCost").value
    })
  });
  loadJob();
}

async function removePart(id) {
  const jobId = "<%= jobId %>";
  await fetch(`/jobs/api/${jobId}/parts/${id}`, { method: "DELETE" });
  loadJob();
}

async function addTech() {
  const jobId = "<%= jobId %>";
  await fetch(`/jobs/api/${jobId}/technicians`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      technician_id: document.getElementById("techSelect").value,
      minutes_worked: document.getElementById("minutes").value
    })
  });
  loadJob();
}

async function removeTech(id) {
  const jobId = "<%= jobId %>";
  await fetch(`/jobs/api/${jobId}/technicians/${id}`, { method: "DELETE" });
  loadJob();
}

loadJob();
</script>

</body>
</html>
